# Cat GPT backend environment variables
# Copy to .env for local dev. On Render, set these in the dashboard.
# Names verified against api/config.py, agent/graph.py, agent/voice.py,
# agent/tools.py, rag/ingest.py on 2026-10-12.

# ===== REQUIRED =====

# Groq API key (LLM + TTS) — get from console.groq.com
GROQ_API_KEY=

# Generate a unique secret (at least 32 characters) and keep it private.
# Python: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Google Identity Services OAuth client ID (Google Cloud Console)
GOOGLE_CLIENT_ID=

# Allowed frontend origins, comma-separated (verified: api/config.py line 68)
FRONTEND_ORIGIN=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001,https://cat-gpt.vercel.app

# ===== OPTIONAL — code defaults are fine, list for reference =====

# Shared auth rate limits across workers/instances; required for distributed
# deployments. Without it, the development fallback is process-local.
#REDIS_URL=redis://localhost:6379/0

# Limit OpenBLAS worker threads to reduce memory use on constrained hosts.
# The application defaults this to 1 when it is unset.
#OPENBLAS_NUM_THREADS=1

# All app data (SQLite DBs, uploads, FAISS index, media) lives here.
# Default: <repo-root>/data  — no need to set on Render.
#DATA_DIR=./data

# Image generation uses Cloudflare Workers AI FLUX.1 Schnell.
# Cloudflare's free plan includes 10,000 Neurons per day.
# Keep credentials private.
Cloudflare_key=
CLOUDFLARE_ACCOUNT_ID=

# Voice / image / upload limits (defaults shown)
#GROQ_TTS_VOICE=Fritz-PlayAI
# Approximate token limit for recent history sent to Groq. Older turns are
# summarized into rolling conversation memory; the current turn is retained.
#GROQ_HISTORY_MAX_TOKENS=4000
#SESSION_TTL_SECONDS=604800
#MAX_FILE_MB=25
#MAX_IMAGE_MB=10
#MAX_UPLOAD_FILES=10
#MAX_IMAGES_PER_REQUEST=3
#MAX_PROMPT_CHARS=8000
# Maximum per-account space for uploaded files and generated images.
#MAX_USER_STORAGE_MB=1024

# Optional integrations for the assistant's extra tools. Set these values
# in your local .env and also configure them in your hosting platform.
#CRICAPI_KEY=
#OMDB_API_KEY=
#RESEND_API_KEY=
#EMAIL_DAILY_LIMIT=5

# Advanced path overrides (defaults are fine)
#UI_DB_PATH=
#UPLOAD_DIR=
